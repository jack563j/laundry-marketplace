# Copy this file to .env for local use, or set these as real environment
# variables in your hosting provider's dashboard. Never commit a real .env.

# Long random string — generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# Set to "production" once deployed — this turns on secure cookies (HTTPS
# only) and the HSTS header. Leave unset for local development.
FLASK_ENV=production

# ─── Database ──────────────────────────────────────────────────────────────
# Neon PostgreSQL (free tier): https://neon.tech → New Project → Connection string
# The app falls back to SQLite locally if this is not set.
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# ─── Razorpay (Payment Gateway) ────────────────────────────────────────────
# Free sign-up at https://razorpay.com
# Dashboard → Settings → API Keys → Generate Test Key Pair
# Use test keys during development (rzp_test_...), switch to live keys for production.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Green API (WhatsApp Notifications — free 500 msgs/month) ──────────────
# Sign up at https://green-api.com
# Create a free instance → link your WhatsApp number → copy instanceId and apiToken
# GREEN_API_INSTANCE_ID=1234567890
# GREEN_API_TOKEN=your_api_token_here

# ─── Face++ (KYC Face Matching — free 1000 req/day, no card needed) ────────
# Sign up at https://console.faceplusplus.com
# Create an App → get API Key and API Secret
# FACE_API_KEY=your_face_api_key
# FACE_API_SECRET=your_face_api_secret
