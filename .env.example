# Copy this file to .env for local use, or set these as real environment
# variables in your hosting provider's dashboard. Never commit a real .env.

# Long random string — generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# Set to "production" once deployed — this turns on secure cookies (HTTPS
# only) and the HSTS header. Leave unset for local development.
FLASK_ENV=production

# Optional: point at a real Postgres database instead of the default
# SQLite file. Most hosts (Render, Railway) give you this connection
# string directly when you add a Postgres add-on.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
